# /etc/devhub/devhub.env  (read by systemd; restart after editing: systemctl restart devhub)
PORT=3000
# 127.0.0.1 = local only (use with the nginx example). 0.0.0.0 = all interfaces.
HOST=127.0.0.1
DEVHUB_DATA=/var/lib/devhub
# Allow new sign-ups (1 = yes, 0 = no). Set to 0 after creating your accounts.
DEVHUB_ALLOW_REGISTER=1
# Set to 1 when served over HTTPS (cookies marked Secure) and to 1 behind nginx/caddy.
DEVHUB_SECURE_COOKIE=0
DEVHUB_TRUST_PROXY=0
# Refuse API-tester / mock / WSDL requests to private network addresses (SSRF guard).
DEVHUB_BLOCK_PRIVATE=0
# Optional: expose a server folder as the "Local" pane in SFTP.
#DEVHUB_LOCAL_ROOT=/srv/files
# Optional: supply your own 32-byte hex encryption key instead of /var/lib/devhub/master.key
#DEVHUB_MASTER_KEY=
# Serve the dummy Workday-style test ERP at /sample/workday (1 = yes, 0 = off).
DEVHUB_SAMPLES=1
